---
import type { GalleryPost } from '../../types/data';
import { pagePath } from '../../utils/paths';
import { responsiveSrcset } from '../../utils/responsiveImage';

interface Props {
    post: GalleryPost;
}

const { post } = Astro.props;
---

<a class="tile" href={pagePath(`posts/${post.id}`)} aria-label={`View post ${post.id}`}>
    <img
        class:list={{ nsfw: post.nsfw }}
        src={post.img}
        srcset={responsiveSrcset(post.imgSources, post.img)}
        sizes="(max-width: 700px) 50vw, (max-width: 1180px) 25vw, 17vw"
        alt=""
        loading="lazy"
        decoding="async"
    />
    {post.nsfw && <span>NSFW</span>}
</a>
