---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Artist, Character } from '../../types/data';
import { getPortraitImages } from '../../lib/server/portraitImages';
import { serializeForScript } from '../../utils/serializeForScript';
import { absoluteSiteUrl } from '../../utils/siteMetadata';
import ProfileCard from './ProfileCard.astro';

interface Props {
    mode: 'character' | 'artist';
    items: Array<Character | Artist>;
}

const { mode, items } = Astro.props;
const pageSize = 24;
const title = mode === 'character' ? 'Character List' : 'Artist List';
const description = mode === 'character'
    ? 'Browse Touhou Project characters featured in the translated archive.'
    : 'Browse artists featured in the Touhou Translations archive.';
const route = mode === 'character' ? 'characters' : 'artists';
const initialItems = mode === 'artist'
    ? [...items].sort((left, right) => {
        const artworkDifference = right.artworkCount - left.artworkCount;
        if (artworkDifference !== 0) return artworkDifference;
        return (right as Artist).characterCount - (left as Artist).characterCount;
    })
    : items;
const portraitImages = await getPortraitImages(items.map(item => item.portrait));
---

<BaseLayout
    title={`${title} | Touhou Translations`}
    {description}
    canonical={absoluteSiteUrl(route)}
    ogTitle={`${title} | Touhou Translations`}
    currentSection={mode === 'character' ? 'characters' : 'artists'}
>
    <section class="list-page" data-list-page data-mode={mode} data-page-size={pageSize}>
        <div class="list-toolbar">
            <h1>{title}</h1>
            <label>
                <span class="visually-hidden">Search by ID or Name</span>
                <input
                    type="search"
                    placeholder="Search by ID or Name"
                    aria-label={`Search ${title}`}
                    data-list-search
                />
            </label>
            {mode === 'character' && (
                <div class="select-tools">
                    <button type="button" aria-pressed="false" data-select-mode>Multi-Select OFF</button>
                    <a class="primary" data-view-selected hidden>View Selected</a>
                </div>
            )}
            <button type="button" class="sort" aria-pressed={mode === 'artist' ? 'true' : 'false'} data-list-sort>
                {mode === 'artist' ? 'Count ↓' : 'Sort'}
            </button>
        </div>

        <ul class="profile-grid" data-list-grid>
            {initialItems.slice(0, pageSize).map(item => (
                <ProfileCard {item} {mode} portraitImage={portraitImages[item.portrait]} />
            ))}
        </ul>

        <button class="load-more" type="button" data-load-more hidden={initialItems.length <= pageSize}>Load More</button>
        <script
            is:inline
            type="application/json"
            data-portrait-images
            set:html={serializeForScript(portraitImages)}
        ></script>
    </section>
    <script src="../../scripts/listPage.ts"></script>
</BaseLayout>

<style is:global>
    .list-page {
        width: min(1600px, 100%);
        padding: 0.5rem 0 1.5rem;
        margin: 0 auto;
    }

    .list-page .list-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.85rem;
        padding: 1rem;
        margin-bottom: 1.25rem;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(10px);
    }

    .list-page .list-toolbar h1 {
        margin: 0;
        color: var(--color-ink);
        font-size: clamp(1.45rem, 2.8vw, 2rem);
        line-height: 1.15;
    }

    .list-page .list-toolbar label {
        flex: 1 1 260px;
        max-width: 440px;
    }

    .list-page .list-toolbar input {
        width: 100%;
        min-height: 44px;
        padding: 0.65rem 0.85rem;
        color: var(--color-ink);
        background: var(--color-surface);
        border: 1px solid var(--color-border-strong);
        border-radius: var(--radius-md);
    }

    .list-page button,
    .list-page .primary {
        display: inline-flex;
        min-height: 40px;
        align-items: center;
        gap: 0.45rem;
        padding: 0.5rem 0.8rem;
        color: var(--color-muted);
        text-decoration: none;
        cursor: pointer;
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: 8px;
    }

    .list-page button.active,
    .list-page .primary {
        color: var(--color-primary);
        background: var(--color-primary-soft);
        border-color: rgba(180, 35, 59, 0.24);
    }

    .list-page .select-tools {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .list-page .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .list-page .profile-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.4rem;
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .list-page .profile-item {
        height: 100%;
        overflow: hidden;
        content-visibility: auto;
        contain-intrinsic-size: auto 150px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    }

    .list-page .profile-item:hover {
        border-color: var(--color-border-strong);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
        transform: translateY(-3px);
    }

    .list-page .profile-item.selected {
        background: var(--color-secondary-soft);
        border-color: var(--color-secondary);
    }

    .list-page .box {
        display: block;
        width: 100%;
        height: 100%;
        padding: 0;
        color: inherit;
        font: inherit;
        text-align: left;
        text-decoration: none;
        cursor: pointer;
        background: transparent;
        border: 0;
    }

    .list-page .content {
        display: grid;
        grid-template-columns: minmax(116px, 34%) minmax(0, 1fr);
        height: 100%;
        min-height: 150px;
        align-items: stretch;
        gap: 1rem;
        padding: 0.75rem;
    }

    .list-page .image-frame {
        align-self: stretch;
        aspect-ratio: 1;
        width: 100%;
        min-width: 0;
        height: auto;
        overflow: hidden;
        background: var(--color-bg-soft);
        border: 1px solid var(--color-border);
        border-radius: calc(var(--radius-lg) - 4px);
    }

    .list-page .image-frame img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .list-page .text {
        display: flex;
        min-width: 0;
        width: 100%;
        flex: 1;
        flex-direction: column;
        justify-content: center;
        padding: 0.2rem 0.25rem 0.2rem 0;
        text-align: left;
    }

    .list-page .checkbox-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 2px;
    }

    .list-page .checkbox-mark {
        display: inline-grid;
        width: 17px;
        height: 17px;
        place-items: center;
        color: white;
        font-size: 0.72rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border-strong);
        border-radius: 4px;
    }

    .list-page .profile-item.selected .checkbox-mark {
        background: var(--color-secondary);
        border-color: var(--color-secondary);
    }

    .list-page .name {
        display: -webkit-box;
        overflow: hidden;
        margin: 0;
        color: var(--color-ink);
        font-size: 1.02rem;
        font-weight: 700;
        white-space: normal;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        line-clamp: 2;
    }

    .list-page .desc {
        margin: 0.35rem 0 0;
        color: var(--color-muted);
        font-size: 0.82rem;
        line-height: 1.4;
    }

    .list-page .load-more {
        margin: 1.25rem auto 0;
    }

    .list-page [hidden] {
        display: none !important;
    }

    @media (min-width: 1280px) {
        .list-page .profile-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @media (max-width: 640px) {
        .list-page {
            padding: 1rem;
        }

        .list-page .list-toolbar {
            align-items: stretch;
            justify-content: flex-start;
            padding: 0.85rem;
        }

        .list-page .list-toolbar h1,
        .list-page .list-toolbar label {
            flex-basis: 100%;
            max-width: none;
        }

        .list-page .profile-grid {
            grid-template-columns: 1fr;
            gap: 0.85rem;
        }

        .list-page .content {
            grid-template-columns: 88px minmax(0, 1fr);
            min-height: 104px;
            padding: 0.75rem;
        }
    }
</style>
