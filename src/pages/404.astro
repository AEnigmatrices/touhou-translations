---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Touhou Translations" description="The requested page could not be found." noindex>
    <section class="not-found">
        <h1>Page not found.</h1>
    </section>
</BaseLayout>

<style>
    .not-found {
        display: grid;
        min-height: 45vh;
        place-items: center;
        text-align: center;
    }

    h1 {
        color: var(--color-ink);
    }
</style>
