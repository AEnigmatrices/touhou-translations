---
import type { GetStaticPaths } from 'astro';
import ListPage from '../../../components/list/ListPage.astro';
import { getArtists } from '../../../lib/content/projections';
import { catalogPageCount, CATALOG_PAGE_SIZES } from '../../../utils/catalogPagination';
import type { Artist } from '../../../types/data';

interface Props {
    items: Artist[];
    currentPage: number;
}

export const getStaticPaths = (async () => {
    const items = await getArtists();
    const count = catalogPageCount(items.length, CATALOG_PAGE_SIZES.artists);
    return Array.from({ length: count - 1 }, (_, index) => ({
        params: { page: String(index + 2) },
        props: { items, currentPage: index + 2 }
    }));
}) satisfies GetStaticPaths;

const { items, currentPage } = Astro.props as Props;
---

<ListPage mode="artist" {items} {currentPage} />
