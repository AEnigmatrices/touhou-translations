{
    "name": "touhou-translations",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "homepage": "https://aenigmatrices.github.io/touhou-translations/",
    "description": "An Astro viewer for English-translated Touhou Project fan comics and illustrations",
    "repository": {
        "type": "git",
        "url": "https://github.com/AEnigmatrices/touhou-translations.git"
    },
    "license": "MIT",
    "author": "AEnigmatrices",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "clean": "tsx scripts/clean.ts",
        "generate:data": "tsx scripts/prepareMediaMetadata.ts --image-dimensions",
        "generate:data:images": "tsx scripts/prepareMediaMetadataCached.ts --image-dimensions",
        "generate:data:responsive-images": "tsx scripts/prepareMediaMetadataCached.ts --image-dimensions --reddit-responsive-images",
        "dev": "astro dev --open",
        "build": "pnpm run generate:data:responsive-images && astro build && tsx scripts/generateServiceWorker.ts && pnpm run verify:build",
        "verify:build": "tsx scripts/verifyBuild.ts",
        "validate:data": "astro sync && tsx scripts/validateContentData.ts",
        "typecheck": "astro check",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "test": "pnpm run validate:data && pnpm run typecheck && pnpm run test:unit",
        "preview": "tsx scripts/preview.ts"
    },
    "dependencies": {
        "astro": "^7.3.5"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.10",
        "@playwright/test": "1.63.0",
        "@types/node": "^24.13.6",
        "@types/sanitize-html": "^2.16.1",
        "marked": "18.0.14",
        "sanitize-html": "2.17.7",
        "sharp": "0.35.4",
        "tsx": "4.23.15",
        "typescript": "~6.0.3",
        "vite": "^8.3.1",
        "vitest": "^5.0.2"
    },
    "packageManager": "pnpm@12.7.0"
}
