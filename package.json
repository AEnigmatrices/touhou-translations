{
    "name": "touhou-translations",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "homepage": "https://aenigmatrices.github.io/touhou-translations/",
    "description": "A viewer for English-translated Touhou Project fan comics and illustrations built with SvelteKit",
    "repository": {
        "type": "git",
        "url": "https://github.com/AEnigmatrices/touhou-translations.git"
    },
    "license": "MIT",
    "author": "AEnigmatrices",
    "scripts": {
        "clean": "tsx scripts/clean.ts",
        "generate:data": "tsx scripts/generateDerivedData.ts",
        "dev": "pnpm run generate:data && vite dev --mode development",
        "build": "pnpm run generate:data && tsx scripts/buildProduction.ts && tsx scripts/generateSitemap.ts",
        "validate:data": "tsx scripts/validateData.ts",
        "typecheck": "pnpm run generate:data && svelte-kit sync && tsc --noEmit",
        "test:unit": "pnpm run generate:data && vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "test": "pnpm run validate:data && pnpm run typecheck && pnpm run test:unit",
        "preview": "vite preview",
        "deploy": "gh-pages -d build --repo https://x-access-token:${GITHUB_TOKEN}@github.com/AEnigmatrices/touhou-translations.git"
    },
    "dependencies": {
        "@sveltejs/adapter-static": "3.0.10",
        "@sveltejs/kit": "2.70.3",
        "@sveltejs/vite-plugin-svelte": "7.3.0",
        "svelte": "5.56.10"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "26.4.0",
        "@types/sanitize-html": "^2.16.1",
        "gh-pages": "6.3.0",
        "glob": "13.0.6",
        "marked": "18.0.11",
        "sanitize-html": "2.17.7",
        "tsx": "4.23.12",
        "typescript": "7.0.2",
        "vite": "8.2.2",
        "vitest": "^4.1.11"
    },
    "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
