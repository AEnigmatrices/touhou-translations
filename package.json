{
    "name": "touhou-translations",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "homepage": "https://aenigmatrices.github.io/touhou-translations/",
    "description": "A viewer for English-translated Touhou Project fan comics and illustrations built with SvelteKit",
    "repository": {
        "type": "git",
        "url": "https://github.com/AEnigmatrices/touhou-translations.git"
    },
    "license": "MIT",
    "author": "AEnigmatrices",
    "scripts": {
        "clean": "tsx scripts/clean.ts",
        "generate:data": "tsx scripts/generateDerivedData.ts",
        "dev": "pnpm run generate:data && vite dev --mode development",
        "build": "pnpm run generate:data && tsx scripts/buildProduction.ts && tsx scripts/generateSitemap.ts",
        "validate:data": "tsx scripts/validateData.ts",
        "typecheck": "pnpm run generate:data && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "lint": "eslint .",
        "test:unit": "pnpm run generate:data && vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "test": "pnpm run validate:data && pnpm run typecheck && pnpm run lint && pnpm run test:unit",
        "preview": "vite preview",
        "deploy": "gh-pages -d build --repo https://x-access-token:${GITHUB_TOKEN}@github.com/AEnigmatrices/touhou-translations.git"
    },
    "dependencies": {
        "@sveltejs/adapter-static": "3.0.10",
        "@sveltejs/kit": "2.70.2",
        "@sveltejs/vite-plugin-svelte": "7.2.0",
        "svelte": "5.56.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "26.1.2",
        "@types/sanitize-html": "^2.16.1",
        "eslint": "10.8.0",
        "eslint-plugin-svelte": "^3.22.0",
        "gh-pages": "6.3.0",
        "glob": "13.0.6",
        "globals": "17.8.0",
        "marked": "18.0.7",
        "sanitize-html": "2.17.6",
        "svelte-check": "4.7.4",
        "tsx": "4.23.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.65.0",
        "vite": "8.2.0",
        "vitest": "^4.1.10"
    },
    "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
