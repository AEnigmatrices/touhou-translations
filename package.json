{
    "name": "touhou-translations",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "homepage": "https://aenigmatrices.github.io/touhou-translations/",
    "description": "An Astro viewer for English-translated Touhou Project fan comics and illustrations",
    "repository": {
        "type": "git",
        "url": "https://github.com/AEnigmatrices/touhou-translations.git"
    },
    "license": "MIT",
    "author": "AEnigmatrices",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "clean": "tsx scripts/clean.ts",
        "generate:data": "tsx scripts/generateDerivedData.ts && tsx scripts/publishRuntimeData.ts",
        "generate:data:images": "tsx scripts/generateDerivedDataCached.ts --image-dimensions && tsx scripts/publishRuntimeData.ts",
        "generate:data:responsive-images": "tsx scripts/generateDerivedDataCached.ts --image-dimensions --reddit-responsive-images && tsx scripts/publishRuntimeData.ts",
        "dev": "pnpm run generate:data && astro dev --open",
        "build": "pnpm run generate:data:responsive-images && astro build && tsx scripts/generateServiceWorker.ts && tsx scripts/generateSitemap.ts && pnpm run verify:build",
        "verify:build": "tsx scripts/verifyBuild.ts",
        "validate:data": "tsx scripts/validateData.ts",
        "typecheck": "pnpm run generate:data && astro check",
        "test:unit": "pnpm run generate:data && vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "test": "pnpm run validate:data && pnpm run typecheck && pnpm run test:unit",
        "preview": "tsx scripts/preview.ts"
    },
    "dependencies": {
        "astro": "7.2.9"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.10",
        "@playwright/test": "^1.62.1",
        "@types/node": "24.3.0",
        "@types/sanitize-html": "^2.16.1",
        "marked": "18.0.11",
        "sanitize-html": "2.17.7",
        "sharp": "0.35.4",
        "tsx": "4.23.13",
        "typescript": "6.0.3",
        "vite": "8.2.2",
        "vitest": "^4.1.11"
    },
    "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
